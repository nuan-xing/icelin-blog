# Public R2 media origin. Use the R2 public URL while testing, then switch to
# a custom image domain without changing content or component code.
PUBLIC_R2_BASE_URL=https://img.example.com

# Optional Cloudflare Image Transform origin. Leave empty to use the R2 URL
# directly; the site must remain usable when transformations are disabled.
PUBLIC_IMAGE_TRANSFORM_BASE=https://img.example.com
