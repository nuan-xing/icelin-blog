/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/admin/*
  Cache-Control: no-store

/api-config.js
  Cache-Control: no-store

/site-app.js
  Cache-Control: public, max-age=0, must-revalidate

/images/*
  Cache-Control: public, max-age=2592000

/generated/images/*
  Cache-Control: public, max-age=2592000

/audio/*
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000
