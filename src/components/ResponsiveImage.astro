---
import imageManifest from '../data/generated-image-manifest.json';
import { getPublicR2MediaUrl, getResponsiveImageSrcset, getTransformedImageUrl, isR2MediaUrl } from '../lib/media.mjs';

type ImageRecord = {
  width: number;
  height: number;
  src: string;
  srcset: string;
};

type Props = {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
  decoding?: 'async' | 'auto' | 'sync';
};

const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  sizes = '(max-width: 760px) calc(100vw - 28px), 760px',
  decoding = 'async',
} = Astro.props;

const record = (imageManifest as Record<string, ImageRecord>)[src];
const externalSrcset = getResponsiveImageSrcset(src);
const renderedSrc = record?.src ?? (isR2MediaUrl(src) && externalSrcset ? getTransformedImageUrl(src, 1080) : getPublicR2MediaUrl(src));
---

<img
  src={renderedSrc}
  srcset={(record?.srcset ?? externalSrcset) || undefined}
  sizes={record || externalSrcset ? sizes : undefined}
  width={record?.width}
  height={record?.height}
  alt={alt}
  class={className}
  loading={loading}
  decoding={decoding}
/>
