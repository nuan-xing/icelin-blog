---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
};

const {
  title = 'icelin',
  description = '生活随笔、摄影作品和个人日记。',
  image = 'https://pub-2ab46ecc311a40e79c4d8c69c5f9da25.r2.dev/qinglong-lake/2026-06-18-hanging-flowers-water.jpg',
  imageAlt = '青龙湖湖边的自然光影',
  type = 'website',
  publishedTime,
} = Astro.props as Props;

const pageTitle = title === 'icelin' ? title : `${title} | icelin`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = new URL(image, siteUrl);
const currentPath = Astro.url.pathname;
const isCurrentPage = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const nav = [
  { href: '/', label: '首页' },
  { href: '/writing/', label: '随笔' },
  { href: '/photos/', label: '摄影' },
  { href: '/about/', label: '关于' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f8f5ee" />
    <meta property="og:site_name" content="icelin" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" type="application/rss+xml" title="icelin 随笔 RSS" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="brand-cluster">
          <a class="brand" href="/" aria-label="icelin 首页">
            <span class="brand-mark"></span>
            <span>icelin</span>
          </a>
          <aside class="music-player" aria-label="背景音乐播放器" transition:persist>
            <audio class="music-audio" src="/audio/二人の時間-RADWIMPS.mp3" preload="none" loop></audio>
            <button class="music-toggle" type="button" aria-label="播放《Time for Two》" aria-pressed="false" title="Time for Two">
              <span class="music-disc" aria-hidden="true">
                <span class="music-icon"></span>
              </span>
            </button>
          </aside>
        </div>
        <nav class="nav" aria-label="主导航">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrentPage(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} icelin</span>
        <span>记录生活，收藏光线。</span>
      </footer>
    </div>
    <script>
      declare global {
        interface Window {
          __icelinBindMotion?: (cards: HTMLElement[]) => void;
          __icelinRefreshLayout?: () => void;
          __icelinMasonryTimer?: number;
          __icelinResizeBound?: boolean;
        }
      }

      const setupMusic = () => {
        const musicRoot = document.querySelector<HTMLElement>('.music-player');
        const musicAudio = musicRoot?.querySelector<HTMLAudioElement>('.music-audio');
        const musicToggle = musicRoot?.querySelector<HTMLButtonElement>('.music-toggle');

        if (!musicRoot || !musicAudio || !musicToggle) return;

        musicAudio.volume = 0.6;

        const getMusicPreference = () => {
          try {
            return window.localStorage.getItem('icelin-bgm');
          } catch {
            return null;
          }
        };

        const setMusicPreference = (value: 'playing' | 'paused') => {
          try {
            window.localStorage.setItem('icelin-bgm', value);
          } catch {
            // Playback still works when storage is unavailable.
          }
        };

        const setMusicUi = (isPlaying: boolean) => {
          musicRoot.classList.toggle('is-playing', isPlaying);
          musicToggle.setAttribute('aria-pressed', String(isPlaying));
          musicToggle.setAttribute('aria-label', isPlaying ? '暂停《Time for Two》' : '播放《Time for Two》');
        };

        setMusicUi(!musicAudio.paused);

        if (musicRoot.dataset.musicBound === 'true') return;
        musicRoot.dataset.musicBound = 'true';

        const tryPlay = async () => {
          if (!musicAudio.paused) return true;

          try {
            await musicAudio.play();
            setMusicUi(true);
            return true;
          } catch {
            setMusicUi(false);
            return false;
          }
        };

        // A first visit should not spend mobile data on background audio. A
        // returning reader who explicitly opted in can still resume it.
        if (getMusicPreference() === 'playing') {
          void tryPlay();
        }

        musicToggle.addEventListener('click', async () => {
          if (!musicAudio.paused) {
            musicAudio.pause();
            setMusicPreference('paused');
            setMusicUi(false);
            return;
          }

          setMusicPreference('playing');
          await tryPlay();
        });

        musicAudio.addEventListener('play', () => setMusicUi(true));
        musicAudio.addEventListener('pause', () => setMusicUi(false));
        musicAudio.addEventListener('error', () => setMusicUi(false));
      };

      const setupMotion = () => {
        const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (motionQuery.matches) return;

        document.documentElement.classList.add('js-motion');

        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              window.setTimeout(() => {
                if (entry.target instanceof HTMLElement) {
                  entry.target.style.transitionDelay = '0ms';
                }
              }, 780);
              revealObserver.unobserve(entry.target);
            });
          },
          {
            threshold: 0.18,
            rootMargin: '0px 0px -8% 0px',
          },
        );

        const observeReveal = (card: HTMLElement, index: number) => {
          if (card.dataset.revealBound === 'true') return;
          card.dataset.revealBound = 'true';
          card.style.transitionDelay = `${Math.min(index * 90, 360)}ms`;
          revealObserver.observe(card);
        };

        const bindMagnet = (card: HTMLElement) => {
          if (card.dataset.magnetBound === 'true') return;
          card.dataset.magnetBound = 'true';
          card.addEventListener('pointermove', (event: PointerEvent) => {
            const rect = card.getBoundingClientRect();
            const isHeaderItem = card.classList.contains('brand') || card.closest('.nav');
            const isPhotoCard = card.classList.contains('photo-card');
            const strengthX = isHeaderItem ? 5 : card.classList.contains('feature-link') ? 8 : isPhotoCard ? 7 : 10;
            const strengthY = isHeaderItem ? 4 : card.classList.contains('feature-link') ? 6 : isPhotoCard ? 5 : 8;
            const x = ((event.clientX - rect.left) / rect.width - 0.5) * strengthX;
            const y = ((event.clientY - rect.top) / rect.height - 0.5) * strengthY;
            card.style.setProperty('--magnet-x', `${x.toFixed(2)}px`);
            card.style.setProperty('--magnet-y', `${y.toFixed(2)}px`);
          });

          card.addEventListener('pointerleave', () => {
            card.style.setProperty('--magnet-x', '0px');
            card.style.setProperty('--magnet-y', '0px');
          });
        };

        document.querySelectorAll<HTMLElement>('.post-row, .feature-link').forEach(observeReveal);
        document.querySelectorAll<HTMLElement>('.post-row, .feature-link, .brand, .nav a').forEach(bindMagnet);

        window.__icelinBindMotion = (cards: HTMLElement[]) => {
          cards.forEach((card, index) => {
            observeReveal(card, index);
            bindMagnet(card);
          });
        };
      };

      const setupMasonry = () => {
        document.querySelectorAll<HTMLElement>('[data-masonry]').forEach((grid) => {
          const existingCards = [...grid.querySelectorAll<HTMLElement>('.photo-card')];
          if (existingCards.length === 0) return;

          const cards = existingCards.map((card) => {
            card.style.removeProperty('width');
            return card;
          });

          grid.classList.remove('is-masonry');
          grid.replaceChildren(...cards);

          const columnCount = window.matchMedia('(max-width: 760px)').matches ? 1 : 2;
          const columns = Array.from({ length: columnCount }, () => {
            const column = document.createElement('div');
            column.className = 'photo-column';
            return column;
          });

          grid.classList.add('is-masonry');
          grid.replaceChildren(...columns);

          const heights = new Array(columnCount).fill(0);
          cards.forEach((card) => {
            const targetIndex = heights.indexOf(Math.min(...heights));
            columns[targetIndex].appendChild(card);
            heights[targetIndex] += card.getBoundingClientRect().height;
          });

          window.__icelinBindMotion?.(cards);
        });
      };

      const scheduleMasonry = () => window.requestAnimationFrame(setupMasonry);

      const setupPage = () => {
        setupMusic();
        setupMotion();
        scheduleMasonry();
      };

      window.__icelinRefreshLayout = () => {
        const cards = [...document.querySelectorAll<HTMLElement>('.post-row, .feature-link, .photo-card')];
        window.__icelinBindMotion?.(cards);
        scheduleMasonry();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupPage, { once: true });
      } else {
        setupPage();
      }

      document.addEventListener('icelin:content-rendered', () => window.__icelinRefreshLayout?.());
      window.addEventListener('load', scheduleMasonry);

      if (!window.__icelinResizeBound) {
        window.__icelinResizeBound = true;
        window.addEventListener('resize', () => {
          window.clearTimeout(window.__icelinMasonryTimer);
          window.__icelinMasonryTimer = window.setTimeout(scheduleMasonry, 120);
        });
      }
    </script>
  </body>
</html>
