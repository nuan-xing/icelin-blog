---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import { qinglongLakePhotos } from '../data/qinglong-lake';
import { astronomyPhotos } from '../data/astronomy';

const photos = (await getCollection('photos'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const topics = (await getCollection('topics'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'));
const getTopicSlug = (topic: typeof topics[number]) => topic.id.replace(/\.md$/, '');
const topicById = new Map(topics.map((topic) => [getTopicSlug(topic), topic]));
const qinglongTopic = topicById.get('qinglong-lake');
const astronomyTopic = topicById.get('astronomy');

if (!qinglongTopic || !astronomyTopic) {
  throw new Error('The built-in photo topics are missing.');
}

const qinglongPreview = qinglongLakePhotos.slice(0, 3);
const astronomyPreview = astronomyPhotos.slice(0, 3);
const topicFeatures = topics.filter((topic) => !['qinglong-lake', 'astronomy'].includes(getTopicSlug(topic))).map((topic) => ({
  topic,
  slug: getTopicSlug(topic),
  photos: photos.filter((photo) => photo.data.topic === getTopicSlug(topic)).slice(0, 3),
}));
---

<BaseLayout title="生活影像">
  <section class="page">
    <div class="section-heading">
      <p class="eyebrow">Life Images</p>
      <h1>生活影像</h1>
      <p>一些日常里被光线、时间和心情留下来的画面。</p>
    </div>

    <div class="feature-list">
      <a class="feature-link" href="/photos/qinglong-lake/">
        <div>
          <p class="eyebrow">{qinglongTopic.data.eyebrow || 'Photo Story'}</p>
          <h2>{qinglongTopic.data.title}</h2>
          <p>{qinglongTopic.data.description}</p>
          <span class="text-link">查看这个专题</span>
        </div>
        <div class="feature-preview" aria-hidden="true">
          {qinglongPreview.length > 0 ? (
            qinglongPreview.map((photo) => (
              <ResponsiveImage src={photo.image} alt="" sizes="(max-width: 760px) 31vw, 96px" />
            ))
          ) : (
            <>
              <span></span>
              <span></span>
              <span></span>
            </>
          )}
        </div>
      </a>

      <a class="feature-link" href="/photos/astronomy/">
        <div>
          <p class="eyebrow">{astronomyTopic.data.eyebrow || 'Photo Story'}</p>
          <h2>{astronomyTopic.data.title}</h2>
          <p>{astronomyTopic.data.description}</p>
          <span class="text-link">查看这个专题</span>
        </div>
        <div class="feature-preview" aria-hidden="true">
          {astronomyPreview.length > 0 ? (
            astronomyPreview.map((photo) => (
              <ResponsiveImage src={photo.image} alt="" sizes="(max-width: 760px) 31vw, 96px" />
            ))
          ) : (
            <>
              <span></span>
              <span></span>
              <span></span>
            </>
          )}
        </div>
      </a>

      {topicFeatures.map(({ topic, slug, photos: topicPhotos }) => (
        <a class="feature-link" href={`/photos/topics/${slug}/`}>
          <div>
            <p class="eyebrow">{topic.data.eyebrow || 'Photo Story'}</p>
            <h2>{topic.data.title}</h2>
            <p>{topic.data.description}</p>
            <span class="text-link">查看这个专题</span>
          </div>
          <div class="feature-preview" aria-hidden="true">
            {topicPhotos.length > 0 ? (
              topicPhotos.map((photo) => (
                <ResponsiveImage src={photo.data.image} alt="" sizes="(max-width: 760px) 31vw, 96px" />
              ))
            ) : (
              <ResponsiveImage src={topic.data.coverImage} alt="" sizes="(max-width: 760px) 31vw, 288px" />
            )}
          </div>
        </a>
      ))}
    </div>

    <div class="section-heading compact-heading">
      <p class="eyebrow">Recent</p>
      <h2>最近的画面</h2>
    </div>
    <div class="photo-grid" data-masonry>
      {photos.map((photo) => (
        <figure class="photo-card">
          <div class="photo-frame">
            <ResponsiveImage
              src={photo.data.image}
              alt={photo.data.alt}
              sizes="(max-width: 760px) calc(100vw - 28px), 520px"
            />
          </div>
          <figcaption>
            <span>{photo.data.title}</span>
            <small>
              {photo.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
              {photo.data.location && ` / ${photo.data.location}`}
            </small>
            <p>{photo.data.caption || photo.data.alt}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
