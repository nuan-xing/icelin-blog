---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { astronomyPhotos } from '../../data/astronomy';

const photos = astronomyPhotos;
---

<BaseLayout
  title="天文"
  description="抬起头来，鼓足勇气，同那熠熠生辉的群星一同共度这转瞬即逝的青春的时光。"
  image={photos[0]?.image}
  imageAlt={photos[0]?.alt}
>
  <section class="page">
    <div class="section-heading">
      <a class="text-link" href="/photos/">返回摄影</a>
      <p class="eyebrow">Astronomy</p>
      <h1>天文</h1>
      <p>抬起头来，鼓足勇气，同那熠熠生辉的群星一同共度这转瞬即逝的青春的时光。</p>
    </div>

    {photos.length > 0 ? (
      <div class="place-timeline">
        {photos.map((photo, index) => (
          <article class="place-entry">
            <time datetime={photo.pubDate.toISOString()}>
              {photo.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </time>
            <figure>
              <ResponsiveImage
                src={photo.image}
                alt={photo.alt}
                loading={index < 2 ? 'eager' : 'lazy'}
                sizes="(max-width: 760px) calc(100vw - 28px), 916px"
              />
              <figcaption>
                <strong>{photo.title}</strong>
                {photo.caption && <span>{photo.caption}</span>}
              </figcaption>
            </figure>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>天文专题已经准备好了。</p>
        <p>等你放入第一组照片后，这里会变成按时间排列的天空观察日记。</p>
      </div>
    )}
  </section>
</BaseLayout>
