---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RuntimeContent from '../../../components/RuntimeContent.astro';

// Existing Markdown only emits current paths; D1 is the visible content source.
export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({ params: { slug: topic.id.replace(/\.md$/, '') } }));
}
---

<BaseLayout title="专题">
  <RuntimeContent fallbackTitle="专题" />
</BaseLayout>
